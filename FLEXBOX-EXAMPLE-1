        <p>
            To master HTML, CSS, JavaScript
            and modern web technologies.
            I enjoy solving problems and
            learning new things every day.
        </p>
    </div>

</section>

<!-- SKILLS -->

<section class="skills">

    <h2 class="section-title">My Skills</h2>

    <div class="skill-container">

        <div class="skill">
            <h3>HTML</h3>
            <p>Website Structure</p>
        </div>

        <div class="skill">
            <h3>CSS</h3>
            <p>Website Styling</p>
        </div>

        <div class="skill">
            <h3>Flexbox</h3>
            <p>Flexible Layouts</p>
        </div>

        <div class="skill">
            <h3>JavaScript</h3>
