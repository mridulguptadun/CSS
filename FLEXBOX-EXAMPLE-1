                 alt="Portfolio project">

            <div class="project-info">
                <h3>Portfolio Design</h3>
                <p>A creative portfolio website design.</p>
            </div>
        </div>

        <div class="project">
            <img src="https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600"
                 alt="Web development project">

            <div class="project-info">
                <h3>Landing Page</h3>
                <p>A responsive landing page layout.</p>
            </div>
        </div>

    </div>

</section>

<!-- CONTACT -->

<section class="contact">

    <h2>Let's Work Together</h2>

    <p>Have a project in mind? Let's connect!</p>

    <button>Contact Me</button>

</section>

<!-- FOOTER -->

<footer>

    <p>© 2026 MyPortfolio</p>

    <div class="footer-links">
        <a href="#">Instagram</a>
        <a href="#">GitHub</a>
        <a href="#">LinkedIn</a>
    </div>

</footer>

</body>
</html>
