    </div>
    <div class="hero-art" aria-label="Animated course progress illustration">
      <div class="art-circle"></div>
      <div class="art-card">
        <small>YOUR LEARNING JOURNEY</small>
        <strong>You're making progress!</strong>
        <p>Keep practising a little every day.</p>
        <div class="art-progress"><span></span></div>
        <small>78% learning goal</small>
      </div>
    </div>
  </section>

  <section class="section" id="courses">
    <div class="section-heading">
      <div>
