        <p>Cards use Grid, shadows, filters, transitions and pseudo-classes.</p>
      </div>
      <span class="property-note">CSS Grid: repeat(3, 1fr)</span>
    </div>
    <div class="course-grid">
      <article class="course-card">
        <div class="course-art">💻</div>
        <div class="course-body">
          <span class="tag">BEGINNER</span>
