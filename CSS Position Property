position: static	     The element stays in its normal position on the page.	                  position: static;
position: relative	   The element moves from its original position.	                          position: relative; top: 10px;
position: absolute	   The element is positioned relative to its nearest positioned parent.	    position: absolute; top: 0; right: 0;
position: fixed	       The element stays in the same place on the screen while scrolling.	      position: fixed; bottom: 0;
position: sticky	     The element sticks to a specified position when scrolling.	              position: sticky; top: 0;
z-index	               It controls which overlapping element appears on top.	                  z-index: 2;
overflow	             It controls what happens when content exceeds the element's size.	      overflow: hidden;
box-sizing	           It controls how an element's width and height are calculated.	          box-sizing: border-box;
opacity	               It controls how transparent an element looks.	                          opacity: 0.5;
cursor	               It changes the mouse pointer's appearance.	                              cursor: pointer;




<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CSS Position Property - A4 Demo</title>

<style>
/* A4 PAGE */
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 15px;
    background: #e5e7eb;
    font-family: Arial, sans-serif;
    color: #1f2937;
}

.sheet {
    width: 210mm;
    min-height: 297mm;
    margin: auto;
    padding: 10mm;
    background: white;
    position: relative;
}

/* HEADER */
header {
    text-align: center;
    border-bottom: 3px solid #2563eb;
    padding-bottom: 10px;
}

header h1 {
    margin: 0 0 6px;
    color: #1d4ed8;
    font-size: 25px;
}

header p {
    margin: 0;
    font-size: 12px;
}

/* EACH EXAMPLE */
.example {
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    padding: 9px;
    margin-top: 10px;
    break-inside: avoid;
}

.example h2 {
    margin: 0 0 6px;
    font-size: 15px;
    color: #1d4ed8;
}

.description {
    margin: 5px 0;
    font-size: 11px;
    line-height: 1.4;
}

.demo {
    height: 65px;
    background: #eff6ff;
    border: 1px dashed #93c5fd;
    position: relative;
    overflow: visible;
}

.box {
    width: 95px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #2563eb;
    color: white;
    font-size: 11px;
    border-radius: 4px;
}

.code {
    margin: 5px 0 0;
    padding: 5px;
    background: #f3f4f6;
    font-size: 10px;
    white-space: pre-wrap;
}

/* 1. STATIC */
.static-box {
    position: static;
    background: #64748b;
}

/* 2. RELATIVE */
.relative-box {
    position: relative;
    top: 12px;
    left: 25px;
    background: #059669;
}

/* 3. ABSOLUTE */
.absolute-parent {
    position: relative;
    height: 65px;
    background: #eff6ff;
    border: 1px dashed #93c5fd;
}

.absolute-box {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #9333ea;
}

/* 4. FIXED */
.fixed-demo {
    position: relative;
    height: 65px;
    background: #eff6ff;
    border: 1px dashed #93c5fd;
}

.fixed-box {
    position: fixed;
    right: 12px;
    bottom: 12px;
    width: 105px;
    height: 32px;
    background: #dc2626;
    z-index: 100;
}

/* 5. STICKY */
.sticky-demo {
    height: 65px;
    overflow-y: auto;
    background: #eff6ff;
    border: 1px dashed #93c5fd;
}

.sticky-box {
    position: sticky;
    top: 0;
    background: #d97706;
}

.note {
    padding: 8px;
    margin-top: 10px;
    background: #fef3c7;
    border-left: 4px solid #d97706;
    font-size: 11px;
    line-height: 1.5;
}

footer {
    margin-top: 10px;
    text-align: center;
    font-size: 10px;
    border-top: 1px solid #cbd5e1;
    padding-top: 7px;
}

@media print {
    @page {
        size: A4 portrait;
        margin: 0;
    }

    body {
        padding: 0;
        background: white;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .sheet {
        width: 210mm;
        min-height: 0;
        margin: 0;
        padding: 10mm;
    }

    .fixed-box {
        display: none;
    }
}
</style>
</head>

<body>

<main class="sheet">

<header>
    <h1>CSS POSITION PROPERTY</h1>
    <p>Complete Practical Guide • HTML + CSS Only • A4 Worksheet</p>
</header>

<!-- STATIC -->
<section class="example">
    <h2>1. position: static</h2>
    <p class="description">
        Default position. The element follows the normal page flow.
        top, right, bottom and left do not move it.
    </p>
    <div class="demo">
        <div class="box static-box">Static Box</div>
    </div>
    <pre class="code">.box {
    position: static;
    top: 20px; /* No effect */
}</pre>
</section>

<!-- RELATIVE -->
<section class="example">
    <h2>2. position: relative</h2>
    <p class="description">
        The element moves relative to its original position.
        Its original space remains reserved.
    </p>
    <div class="demo">
        <div class="box relative-box">Relative Box</div>
    </div>
    <pre class="code">.box {
    position: relative;
    top: 12px;
    left: 25px;
}</pre>
</section>

<!-- ABSOLUTE -->
<section class="example">
    <h2>3. position: absolute</h2>
    <p class="description">
        The element is positioned relative to its nearest positioned
        ancestor. It is removed from normal document flow.
    </p>
    <div class="absolute-parent">
        <div class="box absolute-box">Absolute Box</div>
    </div>
    <pre class="code">.parent {
    position: relative;
}
.box {
    position: absolute;
    top: 10px;
    right: 10px;
}</pre>
</section>

<!-- FIXED -->
<section class="example">
    <h2>4. position: fixed</h2>
    <p class="description">
        The element normally stays at the same viewport position
        while the page scrolls.
    </p>
    <div class="fixed-demo">
        <div class="box">Normal Box</div>
        <p style="font-size:10px; margin:5px;">
            Look at the red box at the bottom-right of the screen.
        </p>
    </div>
    <pre class="code">.box {
    position: fixed;
    right: 12px;
    bottom: 12px;
}</pre>
</section>

<!-- STICKY -->
<section class="example">
    <h2>5. position: sticky</h2>
    <p class="description">
        The element behaves normally until it reaches a scroll
        threshold, then sticks within its scrolling container.
    </p>
    <div class="sticky-demo">
        <div class="box sticky-box">Sticky Box</div>
        <p style="font-size:11px; padding:5px; margin:0;">
            Scroll inside this box to test sticky positioning.<br>
            Content line 2<br>
            Content line 3<br>
            Content line 4<br>
            Content line 5<br>
            Content line 6
        </p>
    </div>
    <pre class="code">.box {
    position: sticky;
    top: 0;
}</pre>
</section>

<div class="note">
    <strong>Important:</strong> Use top, right, bottom and left to
    control placement where applicable. The z-index property controls
    stacking order when elements overlap. It is not a position value.
</div>

<footer>
    CSS Learning Worksheet • Practice all five position values
</footer>

</main>

<!-- FIXED ELEMENT: visible on screen, hidden when printing -->
<div class="box fixed-box">Fixed Box</div>

</body>
</html>
