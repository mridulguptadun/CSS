position: static	     The element stays in its normal position on the page.	                  position: static;
position: relative	   The element moves from its original position.	                          position: relative; top: 10px;
position: absolute	   The element is positioned relative to its nearest positioned parent.	    position: absolute; top: 0; right: 0;
position: fixed	       The element stays in the same place on the screen while scrolling.	      position: fixed; bottom: 0;
position: sticky	     The element sticks to a specified position when scrolling.	              position: sticky; top: 0;
z-index	               It controls which overlapping element appears on top.	                  z-index: 2;
overflow	             It controls what happens when content exceeds the element's size.	      overflow: hidden;
box-sizing	           It controls how an element's width and height are calculated.	          box-sizing: border-box;
opacity	               It controls how transparent an element looks.	                          opacity: 0.5;
cursor	               It changes the mouse pointer's appearance.	                              cursor: pointer;



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Position and Properties</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        h1, h2 {
            text-align: center;
        }

        .section {
            background: white;
            margin: 25px auto;
            padding: 20px;
            width: 90%;
            max-width: 700px;
            border-radius: 10px;
        }

        /* 1. Static */
        .static-box {
            position: static;
            background: lightblue;
            padding: 15px;
        }

        /* 2. Relative */
        .relative-box {
            position: relative;
            top: 10px;
            left: 15px;
            background: lightgreen;
            padding: 15px;
        }

        /* 3. Absolute */
        .parent {
            position: relative;
            height: 120px;
            background: #e2e8f0;
            padding: 15px;
        }

        .absolute-box {
            position: absolute;
            top: 10px;
            right: 10px;
            background: orange;
            padding: 12px;
        }

        /* 4. Fixed */
        .fixed-box {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background: #2563eb;
            color: white;
            padding: 12px;
            border-radius: 8px;
            z-index: 10;
        }

        /* 5. Sticky */
        .sticky-box {
            position: sticky;
            top: 0;
            background: #166534;
            color: white;
            padding: 15px;
            z-index: 5;
        }

        /* 6. Z-index */
        .overlap {
            position: relative;
            height: 130px;
        }

        .box-one, .box-two {
            position: absolute;
            width: 150px;
            height: 80px;
            padding: 12px;
        }

        .box-one {
            top: 10px;
            left: 20px;
            background: tomato;
            z-index: 1;
        }

        .box-two {
            top: 35px;
            left: 75px;
            background: skyblue;
            z-index: 2;
        }

        /* 7. Overflow */
        .overflow-box {
            height: 70px;
            overflow: auto;
            border: 2px solid #64748b;
            padding: 10px;
        }

        /* 8. Box sizing */
        .sizing-box {
            width: 100%;
            padding: 15px;
            border: 5px solid teal;
            background: #ccfbf1;
        }

        /* 9. Opacity */
        .opacity-box {
            padding: 15px;
            background: purple;
            color: white;
            opacity: 0.5;
        }

        /* 10. Cursor */
        .demo-button {
            padding: 12px 20px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .spacer {
            height: 450px;
            padding: 20px;
            text-align: center;
            background: #dbeafe;
        }
    </style>
</head>

<body>

    <h1>CSS Practical Class</h1>
    <p style="text-align:center;">
        Learn CSS properties with examples
    </p>

    <div class="section">
        <h2>1. Position: Static</h2>
        <div class="static-box">
            I stay in my normal position.
        </div>
    </div>

    <div class="section">
        <h2>2. Position: Relative</h2>
        <div class="relative-box">
            I move 10px down and 15px right.
        </div>
        <p>Notice: original space is still reserved.</p>
    </div>

    <div class="section">
        <h2>3. Position: Absolute</h2>
        <div class="parent">
            I am the parent box.
            <div class="absolute-box">
                Absolute Box
            </div>
        </div>
    </div>

    <div class="section">
        <h2>4. Position: Sticky</h2>
        <p>Scroll the page to see sticky behavior.</p>
        <div class="sticky-box">
            I stick to the top while scrolling this page.
        </div>
        <p>Scroll down to observe the sticky bar.</p>
    </div>

    <div class="section">
        <h2>5. Z-index</h2>
        <div class="overlap">
            <div class="box-one">Z-index: 1</div>
            <div class="box-two">Z-index: 2</div>
        </div>
        <p>The blue box appears on top.</p>
    </div>

    <div class="section">
        <h2>6. Overflow</h2>
        <div class="overflow-box">
            This box has limited height. This is extra content.
            This is more extra content. Keep reading to see
            how the scrollbar appears when content is larger
            than the available space inside this box.
        </div>
    </div>

    <div class="section">
        <h2>7. Box Sizing</h2>
        <div class="sizing-box">
            My width includes padding and border because
            box-sizing is border-box.
        </div>
    </div>

    <div class="section">
        <h2>8. Opacity</h2>
        <div class="opacity-box">
            I am 50% opaque.
        </div>
    </div>

    <div class="section">
        <h2>9. Cursor</h2>
        <button class="demo-button">
            Move your mouse here
        </button>
    </div>

    <div class="spacer">
        <h2>Scroll Area</h2>
        Scroll up and down to test sticky and fixed.
    </div>

    <div class="fixed-box">
        I stay fixed on screen!
    </div>

</body>
</html>
