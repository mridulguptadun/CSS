
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flexbox Website Layout</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 12px;
    background: #e2e8f0;
    font-family: Arial, sans-serif;
    color: #1e293b;
}

.page {
    width: 210mm;
    min-height: 297mm;
    margin: auto;
    padding: 8mm;
    background: white;
}

/* HEADER: justify-content + align-items */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 15px;
    background: #172554;
    color: white;
    border-radius: 6px;
}

.logo {
    font-size: 20px;
    font-weight: bold;
}

.header-label {
    font-size: 9px;
    color: #bfdbfe;
}

/* NAVIGATION: justify-content + gap */
.navbar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 9px;
    padding: 9px;
    background: #dbeafe;
    border-radius: 5px;
}

.nav-item {
    padding: 8px 13px;
    background: white;
    color: #1d4ed8;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
}

/* HERO: flex-direction + align-items */
.hero {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 20px;
    background: #bfdbfe;
    border-radius: 7px;
}

.hero-text {
    flex: 1;
}

.hero h1 {
    margin: 0 0 9px;
    font-size: 22px;
    color: #172554;
}

.hero p {
    font-size: 11px;
    line-height: 1.6;
}

.hero-art {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 95px;
    height: 95px;
    background: #2563eb;
    color: white;
    font-size: 24px;
    font-weight: bold;
    border-radius: 12px;
}

/* SECTION TITLE */
h2 {
    font-size: 16px;
    color: #1d4ed8;
    margin: 17px 0 9px;
}

/* COURSE CARDS: flex-wrap + gap */
.cards {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
}

.card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 140px;
    min-width: 0;
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #f8fafc;
}

.card-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 34px;
    height: 34px;
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 6px;
    font-weight: bold;
}

.card h3 {
    font-size: 13px;
    margin: 10px 0 6px;
}

.card p {
    font-size: 10px;
    line-height: 1.5;
    margin: 0;
}

/* CONTENT + SIDEBAR: flex-direction row */
.layout {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
    margin-top: 15px;
}

.main-content {
    display: flex;
    flex-direction: column;
    flex: 2;
    gap: 10px;
}

.content-box {
    padding: 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 5px;
}

.content-box h3 {
    margin: 0 0 7px;
    font-size: 13px;
}

.content-box p {
    font-size: 10px;
    line-height: 1.6;
    margin: 0;
}

.sidebar {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    padding: 12px;
    background: #f1f5f9;
    border-radius: 5px;
}

.sidebar h3 {
    margin: 0;
    font-size: 13px;
}

.side-item {
    padding: 9px;
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 10px;
}

/* STAT BOXES: equal flexible widths */
.stats {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.stat {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    min-height: 75px;
    padding: 10px;
    background: #dbeafe;
    border-radius: 5px;
    text-align: center;
}

.stat strong {
    font-size: 19px;
    color: #1d4ed8;
}

.stat span {
    font-size: 10px;
}

/* FOOTER: space-between */
.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 15px;
    background: #172554;
    color: white;
    border-radius: 5px;
    font-size: 10px;
}

/* PRINT */
@page {
    size: A4 portrait;
    margin: 0;
}

@media print {
    body {
        padding: 0;
        background: white;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;
    }
}
</style>
</head>

<body>
<main class="page">

    <!-- FLEX: justify-content, align-items, gap -->
    <header class="header">
        <div>
            <div class="logo">MyAcademy</div>
            <div class="header-label">
                Header: display: flex
            </div>
        </div>

        <div class="header-label">
            justify-content: space-between<br>
            align-items: center
        </div>
    </header>

    <!-- FLEX: justify-content, flex-wrap, gap -->
    <nav class="navbar">
        <div class="nav-item">Home</div>
        <div class="nav-item">Courses</div>
        <div class="nav-item">About</div>
        <div class="nav-item">Projects</div>
        <div class="nav-item">Contact</div>
    </nav>

    <p style="font-size:9px; margin:5px 0;">
        Navbar: display: flex | justify-content: center | gap: 8px
    </p>

    <!-- FLEX: row direction, space-between, align-items -->
    <section class="hero">
        <div class="hero-text">
            <h1>Learn Web Development</h1>
            <p>
                Learn HTML and CSS with simple lessons and practical
                examples. Build your skills step by step.
            </p>
            <p style="font-size:9px;">
                Hero: display: flex; flex-direction: row
            </p>
        </div>

        <div class="hero-art">CSS</div>
    </section>

    <p style="font-size:9px; margin:5px 0;">
        Hero: justify-content: space-between | align-items: center
    </p>

    <h2>Our Popular Courses</h2>

    <!-- FLEX: wrap, gap, flex-grow, flex-basis -->
    <section class="cards">
        <article class="card">
            <div class="card-icon">H</div>
            <h3>HTML Basics</h3>
            <p>
                Learn page structure, headings, links, images and forms.
            </p>
            <p style="margin-top:8px; color:#1d4ed8;">
                flex: 1 1 140px
            </p>
        </article>

        <article class="card">
            <div class="card-icon">C</div>
            <h3>CSS Design</h3>
            <p>
                Learn colors, spacing, styling and responsive layouts.
            </p>
            <p style="margin-top:8px; color:#1d4ed8;">
                flex: 1 1 140px
            </p>
        </article>

        <article class="card">
            <div class="card-icon">F</div>
            <h3>CSS Flexbox</h3>
            <p>
                Arrange items in rows and columns using Flexbox.
            </p>
            <p style="margin-top:8px; color:#1d4ed8;">
                flex: 1 1 140px
            </p>
        </article>
    </section>

    <p style="font-size:9px; margin:5px 0;">
        Cards: display: flex | flex-wrap: wrap | gap: 10px
    </p>

    <section class="layout">

        <!-- FLEX: column + flex -->
        <div class="main-content">
            <div class="content-box">
                <h3>Why Learn Flexbox?</h3>
                <p>
                    Flexbox helps arrange items in a row or column,
                    distribute space and align elements easily.
                </p>
                <p style="margin-top:6px; color:#1d4ed8;">
                    flex-direction: column
                </p>
            </div>

            <div class="content-box">
                <h3>Practice Activity</h3>
                <p>
                    Change justify-content to center, flex-end and
                    space-between. Observe how the layout changes.
                </p>
            </div>
        </div>

        <!-- FLEX: column sidebar -->
        <aside class="sidebar">
            <h3>Quick Links</h3>
            <div class="side-item">HTML Notes</div>
            <div class="side-item">CSS Notes</div>
            <div class="side-item">Flexbox Guide</div>
            <div class="side-item">Practice Tasks</div>
            <p style="font-size:9px; color:#1d4ed8;">
                display: flex<br>
                flex-direction: column<br>
                gap: 8px
            </p>
        </aside>

    </section>

    <h2>Learning Statistics</h2>

    <!-- FLEX: equal widths, center alignment -->
    <section class="stats">
        <div class="stat">
            <strong>12</strong>
            <span>Lessons</span>
        </div>

        <div class="stat">
            <strong>08</strong>
            <span>Projects</span>
        </div>

        <div class="stat">
            <strong>75%</strong>
            <span>Progress</span>
        </div>
    </section>

    <p style="font-size:9px; margin:5px 0;">
        Stats: display: flex | flex: 1 | align-items: center
    </p>

    <!-- FLEX: footer alignment and wrapping -->
    <footer class="footer">
        <span>MyAcademy | HTML & CSS</span>
        <span>Footer: justify-content: space-between</span>
        <span>© 2026</span>
    </footer>

</main>
</body>
</html>
