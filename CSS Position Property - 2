    </div>
</header>

<!-- NAVIGATION -->
<nav class="navbar">
    <div class="nav-item">Home <small>relative</small></div>
    <div class="nav-item">About <small>relative</small></div>
    <div class="nav-item">Courses <small>relative</small></div>
